{
	"schemaVersion": 1,
	"id": "locator-display",
	"version": "${version}",
	"name": "Locator Display",
	"description": "Just a client-sided locator bar color display mod!",
	"authors": [
		"WRLDExplorer"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/wrldexplorer/locator-display"
	},
	"license": "GPL-3.0-only",
	"icon": "assets/locator-display/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.explorer.locatordisplay.client.LocatorDisplayClient"
		],
		"modmenu": [
			"com.explorer.locatordisplay.client.LocatorDisplayClient"
		]
	},
	"mixins": [
		{
			"config": "locator-display.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": ">=26.1 <26.3",
		"java": ">=25"
	},
	"suggests": {
		"modmenu": "*",
		"cloth-config": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.discord": "",
				"modmenu.github": ""
			},
			"badges": [ "client" ],
			"update_checker": true
		}
	}
}