{
	"schemaVersion": 1,
	"id": "locator-display",
	"version": "${version}",

	"name": "Locator Display",
	"description": "Just a client-sided locator bar color display mod",
	"authors": [
		"WRLDExplorer"
	],

	"contact": {
		"homepage": "https://github.com/wrldexplorer/locator-display",
		"issues": "https://github.com/wrldexplorer/locator-display/issues",
		"sources": "https://github.com/wrldexplorer/locator-display"
	},

	"license": "GPL-3.0-only",
	"icon": "assets/locator-display/icon.png",

	"environment": "client",
	"entrypoints": {
		"client": [
			"com.explorer.locatordisplay.client.LocatorDisplayClient"
		],
		"modmenu": [
			"com.explorer.locatordisplay.client.LocatorDisplayModMenu"
		]
	},
	"mixins": [
		{
			"config": "locator-display.client.mixins.json",
			"environment": "client"
		}
	],

	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": ">=26.2 <26.3",
		"java": ">=25"
	},
	"suggests": {
		"modmenu": "*"
	},

	"custom": {
		"modmenu": {
			"links": {
				"modmenu.wiki": "https://github.com/wrldexplorer/locator-display/blob/main/README.md",
				"modmenu.modrinth": "Waiting for MODRINTH TO APPROVE :/",
				"modmenu.youtube": "https://www.youtube.com/@new_explorer",
				"modmenu.patreon": "https://patreon.com/NewExplorer",
				"modmenu.discord": "https://discord.gg/yKxhm55Z7"
			},
			"update_checker": true
		}
	}
}